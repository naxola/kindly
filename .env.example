# Copy this file to .env for local development. Never commit .env.
# These values ONLY work with the local docker-compose.yml.

# --- General
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Access (ADR 0003). Generate your own: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_RATE_LIMIT_ENABLED=true

# --- Database (ADR 0002)
# Application and worker: role app_user (subject to RLS)
DATABASE_URL=postgresql://app_user:app@localhost:5441/saas
# Migrations: role app_migrator (schema owner)
DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator@localhost:5441/saas
# Integration tests (separate database)
TEST_DATABASE_URL=postgresql://app_user:app@localhost:5441/saas_test
TEST_DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator@localhost:5441/saas_test
# Only for `prisma migrate dev` (temporary comparison database)
SHADOW_DATABASE_URL=postgresql://app_migrator:migrator@localhost:5441/saas_shadow

# --- Email (worker). Local: `log` prints emails in the worker log and sends nothing
# (refused outside development/test). Mailtrap: EMAIL_PROVIDER=smtp + SMTP_*.
# Staging/production: EMAIL_PROVIDER=resend + RESEND_API_KEY=re_...
EMAIL_PROVIDER=log
EMAIL_FROM="Kindly <no-reply@example.com>"

# --- Business events (ADR 0010). Empty: events are only logged by the worker.
# EVENTS_WEBHOOK_URL=https://n8n.example.com/webhook/saas-events
# EVENTS_WEBHOOK_SECRET=  (openssl rand -hex 32)

# --- Worker
WORKER_CONCURRENCY=2

# --- Public site (apps/site). Read at build time.
SITE_URL=http://localhost:3001
# Plausible (cookieless analytics). Empty: no analytics script.
# PLAUSIBLE_DOMAIN=example.com

# --- Observability (ADR 0008). All optional: without them errors and alerts only go to the logs.
# Sentry or GlitchTip DSN (same protocol), used by web and worker
# SENTRY_DSN=
# Alerts to the phone: none | ntfy | telegram
ALERT_PROVIDER=none
# NTFY_URL=https://ntfy.sh/your-secret-topic
# NTFY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Worker /health and /ready (0 disables) and stuck-queue threshold
WORKER_HEALTH_PORT=3002
QUEUE_MAX_WAIT_SECONDS=900
# Push heartbeat of the worker (Uptime Kuma push monitor URL). Secret: it carries a token.
# HEARTBEAT_URL=https://kuma.example.com/api/push/<token>?status=up&msg=OK

# --- Payments (ADR 0012). none: only the default plan, no checkout.
PAYMENT_PROVIDER=none
# PAYMENT_PROVIDER=paddle
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=pdl_sdbx_apikey_...
# PADDLE_CLIENT_TOKEN=test_...
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# PADDLE_OVERAGE_PRODUCT_ID=pro_...

# --- Messaging (WhatsApp). The test adapter talks to Meta's free TEST number to validate the real
# webhook pipeline; it is refused when APP_ENV=production. Leave everything empty for none.
WHATSAPP_TEST_ADAPTER_ENABLED=
# WHATSAPP_TEST_PHONE_NUMBER_ID=
# WHATSAPP_TEST_WABA_ID=
# WHATSAPP_TEST_ACCESS_TOKEN=
# WHATSAPP_TEST_APP_SECRET=
# WHATSAPP_TEST_VERIFY_TOKEN=
# Countries where coexistence is not offered (comma-separated ISO codes). Empty = "cannot check".
WHATSAPP_UNSUPPORTED_COUNTRY_CODES=
