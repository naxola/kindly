# Copia este archivo a .env y ajusta los valores. Nunca commitees .env real
# (ver CLAUDE.md sección 5 — Seguridad).

# PostgreSQL local (levantada con `docker compose up -d`, ver docker-compose.yml)
DATABASE_URL=postgresql://kindly:kindly@localhost:5432/kindly

# Solo en staging/producción (Vercel + integración de Neon): URL de conexión
# directa, sin pooler, que la integración inyecta junto a DATABASE_URL.
# drizzle.config.ts la usa para migraciones si existe; la app en runtime
# sigue usando siempre DATABASE_URL (pooled). Vacía en local — no hace falta
# rellenarla a mano.
DATABASE_URL_UNPOOLED=

# Base de datos separada para tests de integración (npm test). Se crea sola
# la primera vez que se levanta el contenedor (docker/init-test-db.sh).
TEST_DATABASE_URL=postgresql://kindly:kindly@localhost:5432/kindly_test

# Genera un valor real con: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-random-secret

BETTER_AUTH_URL=http://localhost:3000

# Códigos de país (ISO de dos letras, separados por comas) donde WhatsApp
# coexistence NO está disponible. Vacío por defecto y a propósito: la lista
# oficial de Meta no está confirmada (ver docs/DECISIONS.md), y una copiada de
# una fuente no oficial bloquearía a usuarios reales con falsa seguridad.
# Con el valor vacío, Kindly dice que no puede comprobarlo en vez de adivinar.
WHATSAPP_UNSUPPORTED_COUNTRY_CODES=

# Dominio público del sitio (sin barra final). Debe coincidir exactamente con
# el dominio que verifiques en Meta Business Manager.
NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Token de verificación de dominio de Meta: Business Manager → Seguridad de
# marca → Dominios → método de metaetiqueta. Sin esto, el dominio no se puede
# usar para la verificación de negocio.
FACEBOOK_DOMAIN_VERIFICATION=

# PKG-011 — WhatsApp Cloud API contra el número de prueba de Meta. Solo en
# Vercel Preview / rama staging, NUNCA en Production (se ignora ahí de todos
# modos). Se registra solo con el flag a "true" Y todas las credenciales.
# Valores reales únicamente en Vercel, jamás en este archivo.
WHATSAPP_TEST_ADAPTER_ENABLED=
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_WABA_ID=
WHATSAPP_TEST_ACCESS_TOKEN=
WHATSAPP_TEST_APP_SECRET=
WHATSAPP_TEST_VERIFY_TOKEN=
