# Copia este archivo a .env y ajusta los valores. Nunca commitees .env real
# (ver CLAUDE.md sección 5 — Seguridad).

# PostgreSQL local (levantada con `docker compose up -d`, ver docker-compose.yml)
DATABASE_URL=postgresql://kindly:kindly@localhost:5432/kindly

# Base de datos separada para tests de integración (npm test). Se crea sola
# la primera vez que se levanta el contenedor (docker/init-test-db.sh).
TEST_DATABASE_URL=postgresql://kindly:kindly@localhost:5432/kindly_test

# Genera un valor real con: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-real-random-secret

BETTER_AUTH_URL=http://localhost:3000

# Códigos de país (ISO de dos letras, separados por comas) donde WhatsApp
# coexistence NO está disponible. Vacío por defecto y a propósito: la lista
# oficial de Meta no está confirmada (ver docs/DECISIONS.md), y una copiada de
# una fuente no oficial bloquearía a usuarios reales con falsa seguridad.
# Con el valor vacío, Kindly dice que no puede comprobarlo en vez de adivinar.
WHATSAPP_UNSUPPORTED_COUNTRY_CODES=
