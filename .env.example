# Copy this file to .env for local development. Never commit .env.
# These values ONLY work with the local docker-compose.yml.

# --- General
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Access (ADR 0003). Generate your own: openssl rand -base64 48
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
AUTH_RATE_LIMIT_ENABLED=true

# --- Database (ADR 0002)
# Application and worker: role app_user (subject to RLS)
DATABASE_URL=postgresql://app_user:app@localhost:5441/saas
# Migrations: role app_migrator (schema owner)
DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator@localhost:5441/saas
# Integration tests (separate database)
TEST_DATABASE_URL=postgresql://app_user:app@localhost:5441/saas_test
TEST_DATABASE_MIGRATOR_URL=postgresql://app_migrator:migrator@localhost:5441/saas_test
# Only for `prisma migrate dev` (temporary comparison database)
SHADOW_DATABASE_URL=postgresql://app_migrator:migrator@localhost:5441/saas_shadow
