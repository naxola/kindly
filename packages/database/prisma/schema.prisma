// Conventions:
// - UUID v7 ids generated by the application (time-ordered; independent of the Postgres version).
// - organization_id on every tenant table, with forced RLS (ADR 0002).
// - RLS policies and grants are written by hand in SQL inside the migrations.
// - Access tables (auth_*) and business users arrive in phase 2 (ADR 0003).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  SYSTEM
}

/// Tenant root (ADR 0002). RLS: only the active organization is visible.
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  defaultLocale String    @default("es") @map("default_locale")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)

  auditLogs AuditLog[]

  @@map("organizations")
}

/// Append-only: app_user has no UPDATE or DELETE.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  before         Json?
  after          Json?
  correlationId  String?        @map("correlation_id")
  ip             String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}
