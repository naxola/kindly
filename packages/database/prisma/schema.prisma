// Conventions:
// - UUID v7 ids generated by the application (time-ordered; independent of the Postgres version).
// - organization_id on every tenant table, with forced RLS (ADR 0002).
// - RLS policies and grants are written by hand in SQL inside the migrations.
// - Access (auth_*) is separated from business identity (users, organization_members): ADR 0003.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  SYSTEM
}

/// Tenant root (ADR 0002). RLS: only the active organization is visible.
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  defaultLocale String    @default("es") @map("default_locale")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)

  auditLogs      AuditLog[]
  members        OrganizationMember[]
  invitations    Invitation[]
  subscription   Subscription?
  usageEvents    UsageEvent[]
  billingPeriods BillingPeriod[]
  // Kindly (team): positions and member profiles of the organization.
  memberPositions    MemberPosition[]
  memberProfiles     MemberProfile[]
  invitationProfiles InvitationProfile[]

  @@map("organizations")
}

/// Append-only: app_user has no UPDATE or DELETE.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  before         Json?
  after          Json?
  correlationId  String?        @map("correlation_id")
  ip             String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

// ============================================================================
// ACCESS (ADR 0003). Global tables managed by Better Auth. They only know who can
// sign in: no column or foreign key points to business tables.
// ============================================================================

model AuthUser {
  id            String   @id @db.Uuid
  /// Required by Better Auth. Technical minimum: the visible name lives in `users`.
  name          String
  email         String   @unique @db.Citext
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions AuthSession[]
  accounts AuthAccount[]
  user     User?

  @@map("auth_users")
}

model AuthSession {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (scrypt) for the "credential" provider. Never logged or returned.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

// ============================================================================
// BUSINESS IDENTITY (ADR 0003). The link to access lives here: users.auth_user_id.
// ============================================================================

/// The person inside the SaaS. Created on first entry, not at sign-up. Global (no tenant RLS).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Null once the access is deleted (GDPR): business history stays, anonymized.
  authUserId   String?   @unique @map("auth_user_id") @db.Uuid
  displayName  String    @map("display_name")
  /// Preferred locale (es/en). Null = the organization's default.
  locale       String?
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  authUser            AuthUser?            @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  memberships         OrganizationMember[]
  acceptedInvitations Invitation[]         @relation("AcceptedInvitations")

  @@map("users")
}

/// Template roles. Products map their own permissions onto them in core/identity.
enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

/// A person in an organization, with their role. Business tables reference this id.
model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  disabledAt     DateTime?        @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitationsCreated Invitation[] @relation("InvitedBy")
  profile            MemberProfile?

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// The token is only stored hashed (SHA-256). It expires and can be revoked.
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.Citext
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById      String           @map("invited_by_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    OrganizationMember @relation("InvitedBy", fields: [organizationId, invitedById], references: [organizationId, id], onDelete: Restrict)
  acceptedBy   User?              @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  profile      InvitationProfile?

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@map("invitations")
}

// ============================================================================
// BILLING (ADR 0012). The plan catalog lives in code (core/billing/catalog.ts), versioned;
// the database stores which plan version each organization has and what it consumed.
// ============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Plan of an organization. Without a row, the organization is on the catalog's default plan.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planKey                String             @map("plan_key")
  planVersion            Int                @map("plan_version")
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// Maximum overage per period, in the plan currency. Null = no cap.
  spendCap               Decimal?           @map("spend_cap") @db.Decimal(14, 2)
  /// Payment provider (B3). Null while the plan is free.
  provider               String?
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(3)
  /// occurred_at of the last provider event applied: older events arrive late and are ignored.
  providerUpdatedAt      DateTime?          @map("provider_updated_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@map("subscriptions")
}

/// Metered usage. Append-only for app_user; one row per business effect (idempotency key).
model UsageEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metric         String
  quantity       Decimal  @db.Decimal(20, 6)
  /// For `unique` metrics: what is counted once per period (e.g. a member id).
  subjectKey     String?  @map("subject_key")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metric, occurredAt])
  @@map("usage_events")
}

enum BillingPeriodStatus {
  /// Nothing to charge beyond the fixed price (the provider charges that itself).
  NO_CHARGE
  /// Overage computed, waiting to be charged at the provider.
  PENDING_CHARGE
  CHARGED
  CHARGE_FAILED
}

/// Immutable snapshot of a closed period (ADR 0012). Only the charge columns change later.
model BillingPeriod {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  subscriptionId    String              @map("subscription_id") @db.Uuid
  planKey           String              @map("plan_key")
  planVersion       Int                 @map("plan_version")
  currency          String
  periodStart       DateTime            @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime            @map("period_end") @db.Timestamptz(3)
  /// Fixed price of the plan, for reference: the provider charges it with the subscription.
  fixedPrice        Decimal             @map("fixed_price") @db.Decimal(14, 2)
  /// Sum of the overage lines, before the spend cap.
  overageTotal      Decimal             @map("overage_total") @db.Decimal(14, 2)
  spendCap          Decimal?            @map("spend_cap") @db.Decimal(14, 2)
  /// What is charged for usage: overage total limited by the spend cap.
  amountDue         Decimal             @map("amount_due") @db.Decimal(14, 2)
  status            BillingPeriodStatus
  providerChargeRef String?             @map("provider_charge_ref")
  chargedAt         DateTime?           @map("charged_at") @db.Timestamptz(3)
  closedAt          DateTime            @map("closed_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        BillingPeriodLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, subscriptionId, periodStart])
  @@index([organizationId, periodStart])
  @@map("billing_periods")
}

/// One metric of a closed period. Append-only.
model BillingPeriodLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  periodId       String   @map("period_id") @db.Uuid
  metric         String
  unit           String
  used           Decimal  @db.Decimal(20, 6)
  /// Null = unlimited.
  included       Decimal? @db.Decimal(20, 6)
  overageUnits   Decimal  @map("overage_units") @db.Decimal(20, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 6)
  amount         Decimal  @db.Decimal(14, 2)

  period BillingPeriod @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)

  @@unique([periodId, metric])
  @@index([organizationId])
  @@map("billing_period_lines")
}

// ============================================================================
// TEAM (Kindly, docs/DECISIONS.md D4/D14/D15). Access (auth_*) and the access role
// (organization_members.role) are the template's; the person's data and their position
// inside the organization are Kindly's, per tenant.
// ============================================================================

/// Position (cargo) of a member inside an organization: delegate, president... Just a name:
/// no rule or permission reads it. Archived instead of deleted when in use.
model MemberPosition {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String    @db.Citext
  sortOrder      Int       @default(0) @map("sort_order")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profiles           MemberProfile[]
  invitationProfiles InvitationProfile[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@map("member_positions")
}

/// Data of a person as a member of one organization (1:1 with organization_members).
/// Only the first name is required. The phone is contact data, NOT the WhatsApp identity
/// (that lives in messaging accounts).
model MemberProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  memberId       String   @map("member_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  /// E.164, e.g. +34600111222.
  phone          String?
  contactEmail   String?  @map("contact_email") @db.Citext
  positionId     String?  @map("position_id") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  member       OrganizationMember @relation(fields: [organizationId, memberId], references: [organizationId, id], onDelete: Restrict)
  position     MemberPosition?    @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, memberId])
  @@index([organizationId, positionId])
  @@map("member_profiles")
}

/// Profile data chosen by the ADMIN when inviting; copied to member_profiles when the
/// invitation is accepted, in the same transaction.
model InvitationProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  invitationId   String   @map("invitation_id") @db.Uuid
  firstName      String   @map("first_name")
  lastName       String?  @map("last_name")
  phone          String?
  positionId     String?  @map("position_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitation   Invitation      @relation(fields: [organizationId, invitationId], references: [organizationId, id], onDelete: Restrict)
  position     MemberPosition? @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, invitationId])
  @@map("invitation_profiles")
}
