// Conventions:
// - UUID v7 ids generated by the application (time-ordered; independent of the Postgres version).
// - organization_id on every tenant table, with forced RLS (ADR 0002).
// - RLS policies and grants are written by hand in SQL inside the migrations.
// - Access (auth_*) is separated from business identity (users, organization_members): ADR 0003.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  SYSTEM
}

/// Tenant root (ADR 0002). RLS: only the active organization is visible.
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  defaultLocale String    @default("es") @map("default_locale")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)

  auditLogs           AuditLog[]
  members             OrganizationMember[]
  invitations         Invitation[]
  subscription        Subscription?
  usageEvents         UsageEvent[]
  billingPeriods      BillingPeriod[]
  subscriptionPeriods SubscriptionPeriod[]

  @@map("organizations")
}

/// Append-only: app_user has no UPDATE or DELETE.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  before         Json?
  after          Json?
  correlationId  String?        @map("correlation_id")
  ip             String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
// ACCESS (ADR 0003). Global tables managed by Better Auth. They only know who can
// sign in: no column or foreign key points to business tables.
// ============================================================================

model AuthUser {
  id               String   @id @db.Uuid
  /// Required by Better Auth. Technical minimum: the visible name lives in `users`.
  name             String
  email            String   @unique @db.Citext
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  /// Second factor active (ADR 0016). Managed by Better Auth; the business never reads it.
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions   AuthSession[]
  accounts   AuthAccount[]
  twoFactors AuthTwoFactor[]
  user       User?

  @@map("auth_users")
}

model AuthSession {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// TOTP secret and recovery codes of a person (ADR 0016). Both are stored encrypted by Better Auth
/// with the application secret (versioned, see BETTER_AUTH_SECRETS); never returned or logged.
model AuthTwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  /// False until the first code is verified: an unfinished set-up never protects the account.
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_two_factors")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (scrypt) for the "credential" provider. Never logged or returned.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

// ============================================================================
// BUSINESS IDENTITY (ADR 0003). The link to access lives here: users.auth_user_id.
// ============================================================================

/// The person inside the SaaS. Created on first entry, not at sign-up. Global (no tenant RLS).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Null once the access is deleted (GDPR): business history stays, anonymized.
  authUserId   String?   @unique @map("auth_user_id") @db.Uuid
  displayName  String    @map("display_name")
  /// Preferred locale (es/en). Null = the organization's default.
  locale       String?
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  authUser            AuthUser?            @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  memberships         OrganizationMember[]
  acceptedInvitations Invitation[]         @relation("AcceptedInvitations")

  @@map("users")
}

/// Template roles. Products map their own permissions onto them in core/identity.
enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

/// A person in an organization, with their role. Business tables reference this id.
model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  disabledAt     DateTime?        @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitationsCreated Invitation[] @relation("InvitedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// The token is only stored hashed (SHA-256). It expires and can be revoked.
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.Citext
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById      String           @map("invited_by_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    OrganizationMember @relation("InvitedBy", fields: [organizationId, invitedById], references: [organizationId, id], onDelete: Restrict)
  acceptedBy   User?              @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@map("invitations")
}

/// Counters of the request limiter (ADR 0015). Global: no tenant, no RLS. `key` is a SHA-256
/// of scope and identifier, never an IP, an email or an id in the clear.
model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int

  @@index([windowStart])
  @@map("rate_limits")
}

enum EmailSuppressionReason {
  BOUNCE_PERMANENT
  COMPLAINT
}

/// Addresses the product must not write to again (ADR 0017). Global: no tenant, no RLS.
/// Only the SHA-256 of the normalized address is kept, never the address.
model EmailSuppression {
  emailHash     String                 @map("email_hash")
  reason        EmailSuppressionReason
  /// Provider event that caused it (idempotency and traceability).
  sourceEventId String?                @map("source_event_id")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([emailHash, reason])
  @@map("email_suppressions")
}

// ============================================================================
// BILLING (ADR 0012). The plan catalog lives in code (core/billing/catalog.ts), versioned;
// the database stores which plan version each organization has and what it consumed.
// ============================================================================

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

/// Plan of an organization. Without a row, the organization is on the catalog's default plan.
model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  planKey                String             @map("plan_key")
  planVersion            Int                @map("plan_version")
  status                 SubscriptionStatus
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// Maximum overage per period, in the plan currency. Null = no cap.
  spendCap               Decimal?           @map("spend_cap") @db.Decimal(14, 2)
  /// Payment provider (B3). Null while the plan is free.
  provider               String?
  providerSubscriptionId String?            @unique @map("provider_subscription_id")
  providerCustomerId     String?            @map("provider_customer_id")
  pastDueSince           DateTime?          @map("past_due_since") @db.Timestamptz(3)
  /// occurred_at of the last provider event applied: older events arrive late and are ignored.
  providerUpdatedAt      DateTime?          @map("provider_updated_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periods      SubscriptionPeriod[]

  @@unique([organizationId, id])
  @@map("subscriptions")
}

/// Plan and version in force during each billing period of a subscription, written when the
/// period starts or is synced (ADR 0014). The close uses it instead of guessing the past.
model SubscriptionPeriod {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  periodStart    DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime @map("period_end") @db.Timestamptz(3)
  planKey        String   @map("plan_key")
  planVersion    Int      @map("plan_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [organizationId, subscriptionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, subscriptionId, periodStart])
  @@map("subscription_periods")
}

/// Metered usage. Append-only for app_user; one row per business effect (idempotency key).
model UsageEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  metric         String
  quantity       Decimal  @db.Decimal(20, 6)
  /// For `unique` metrics: what is counted once per period (e.g. a member id).
  subjectKey     String?  @map("subject_key")
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, metric, occurredAt])
  @@map("usage_events")
}

enum BillingPeriodStatus {
  /// Nothing to charge beyond the fixed price (the provider charges that itself).
  NO_CHARGE
  /// Overage computed, waiting to be charged at the provider.
  PENDING_CHARGE
  /// Charge being sent to the provider. Written and committed BEFORE the call: if the process
  /// dies after the provider charged, the period stays here (outcome unknown, check the
  /// provider) and is never retried automatically. ADR 0014.
  CHARGING
  CHARGED
  CHARGE_FAILED
}

/// Immutable snapshot of a closed period (ADR 0012). Only the charge columns change later.
model BillingPeriod {
  id                String              @id @default(uuid(7)) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  subscriptionId    String              @map("subscription_id") @db.Uuid
  planKey           String              @map("plan_key")
  planVersion       Int                 @map("plan_version")
  currency          String
  periodStart       DateTime            @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime            @map("period_end") @db.Timestamptz(3)
  /// Fixed price of the plan, for reference: the provider charges it with the subscription.
  fixedPrice        Decimal             @map("fixed_price") @db.Decimal(14, 2)
  /// Sum of the overage lines, before the spend cap.
  overageTotal      Decimal             @map("overage_total") @db.Decimal(14, 2)
  spendCap          Decimal?            @map("spend_cap") @db.Decimal(14, 2)
  /// What is charged for usage: overage total limited by the spend cap.
  amountDue         Decimal             @map("amount_due") @db.Decimal(14, 2)
  status            BillingPeriodStatus
  providerChargeRef String?             @map("provider_charge_ref")
  chargedAt         DateTime?           @map("charged_at") @db.Timestamptz(3)
  closedAt          DateTime            @map("closed_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        BillingPeriodLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, subscriptionId, periodStart])
  @@index([organizationId, periodStart])
  @@map("billing_periods")
}

/// One metric of a closed period. Append-only.
model BillingPeriodLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  periodId       String   @map("period_id") @db.Uuid
  metric         String
  unit           String
  used           Decimal  @db.Decimal(20, 6)
  /// Null = unlimited.
  included       Decimal? @db.Decimal(20, 6)
  overageUnits   Decimal  @map("overage_units") @db.Decimal(20, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(14, 6)
  amount         Decimal  @db.Decimal(14, 2)

  period BillingPeriod @relation(fields: [organizationId, periodId], references: [organizationId, id], onDelete: Restrict)

  @@unique([periodId, metric])
  @@index([organizationId])
  @@map("billing_period_lines")
}
