// Conventions:
// - UUID v7 ids generated by the application (time-ordered; independent of the Postgres version).
// - organization_id on every tenant table, with forced RLS (ADR 0002).
// - RLS policies and grants are written by hand in SQL inside the migrations.
// - Access (auth_*) is separated from business identity (users, organization_members): ADR 0003.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuditActorType {
  USER
  SYSTEM
}

/// Tenant root (ADR 0002). RLS: only the active organization is visible.
model Organization {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  slug          String    @unique
  defaultLocale String    @default("es") @map("default_locale")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)

  auditLogs   AuditLog[]
  members     OrganizationMember[]
  invitations Invitation[]

  @@map("organizations")
}

/// Append-only: app_user has no UPDATE or DELETE.
model AuditLog {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String?        @map("organization_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  before         Json?
  after          Json?
  correlationId  String?        @map("correlation_id")
  ip             String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId])
  @@map("audit_logs")
}

// ============================================================================
// ACCESS (ADR 0003). Global tables managed by Better Auth. They only know who can
// sign in: no column or foreign key points to business tables.
// ============================================================================

model AuthUser {
  id            String   @id @db.Uuid
  /// Required by Better Auth. Technical minimum: the visible name lives in `users`.
  name          String
  email         String   @unique @db.Citext
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions AuthSession[]
  accounts AuthAccount[]
  user     User?

  @@map("auth_users")
}

model AuthSession {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash (scrypt) for the "credential" provider. Never logged or returned.
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("auth_verifications")
}

// ============================================================================
// BUSINESS IDENTITY (ADR 0003). The link to access lives here: users.auth_user_id.
// ============================================================================

/// The person inside the SaaS. Created on first entry, not at sign-up. Global (no tenant RLS).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Null once the access is deleted (GDPR): business history stays, anonymized.
  authUserId   String?   @unique @map("auth_user_id") @db.Uuid
  displayName  String    @map("display_name")
  /// Preferred locale (es/en). Null = the organization's default.
  locale       String?
  anonymizedAt DateTime? @map("anonymized_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  authUser            AuthUser?            @relation(fields: [authUserId], references: [id], onDelete: SetNull)
  memberships         OrganizationMember[]
  acceptedInvitations Invitation[]         @relation("AcceptedInvitations")

  @@map("users")
}

/// Template roles. Products map their own permissions onto them in core/identity.
enum OrganizationRole {
  ADMIN
  MEMBER
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

/// A person in an organization, with their role. Business tables reference this id.
model OrganizationMember {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           OrganizationRole
  status         MemberStatus     @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  disabledAt     DateTime?        @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user               User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitationsCreated Invitation[] @relation("InvitedBy")

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

/// The token is only stored hashed (SHA-256). It expires and can be revoked.
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.Citext
  role             OrganizationRole
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedById      String           @map("invited_by_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    OrganizationMember @relation("InvitedBy", fields: [organizationId, invitedById], references: [organizationId, id], onDelete: Restrict)
  acceptedBy   User?              @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, email])
  @@map("invitations")
}
