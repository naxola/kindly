# Variables of the staging deployment (infra/staging/compose.yml). In Coolify they go in the
# resource's "Environment Variables"; never in the repository. Passwords: openssl rand -hex 24
# (hex only: they go inside database URLs).

APP_URL=https://app.staging.example.com
BETTER_AUTH_SECRET=        # openssl rand -base64 48
POSTGRES_PASSWORD=
APP_MIGRATOR_PASSWORD=
APP_USER_PASSWORD=
APP_PLATFORM_PASSWORD=

# Email: resend (RESEND_API_KEY) or smtp (SMTP_*)
EMAIL_PROVIDER=resend
EMAIL_FROM="Kindly <no-reply@staging.example.com>"
RESEND_API_KEY=

# Optional
# IMAGE_TAG=staging        # or sha-<commit> to pin a version
# SENTRY_DSN=              # GlitchTip project DSN
# ALERT_PROVIDER=ntfy
# NTFY_URL=https://ntfy.example.com/<secret-topic>
# NTFY_TOKEN=
# HEARTBEAT_URL=           # Uptime Kuma push monitor URL
# EVENTS_WEBHOOK_URL=
# EVENTS_WEBHOOK_SECRET=

# Payments (docs/deploy.md). Staging always against the Paddle SANDBOX.
# PAYMENT_PROVIDER=paddle
# PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=
# PADDLE_CLIENT_TOKEN=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_OVERAGE_PRODUCT_ID=

# Messaging (WhatsApp test number of Meta, to validate the real webhook pipeline). Secrets.
# WHATSAPP_TEST_ADAPTER_ENABLED=true
# WHATSAPP_TEST_PHONE_NUMBER_ID=
# WHATSAPP_TEST_WABA_ID=
# WHATSAPP_TEST_ACCESS_TOKEN=
# WHATSAPP_TEST_APP_SECRET=
# WHATSAPP_TEST_VERIFY_TOKEN=
# WHATSAPP_UNSUPPORTED_COUNTRY_CODES=

# Knowledge base: embeddings for uploads (worker). Without it ingestions fail with a clear code.
# OPENAI_API_KEY=
