{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "tasks": {
    "generate": {
      "inputs": ["prisma/**", "prisma.config.ts", "src/server/api/**", "scripts/export-openapi.ts"],
      "outputs": ["src/generated/**"],
      "cache": false,
      "dependsOn": ["^generate"],
      "passThroughEnv": ["DATABASE_MIGRATOR_URL", "SHADOW_DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
